---
/**
 * The architecture, as an actual diagram rather than a paragraph.
 *
 * Each stage carries `data-stage`, matching the stage names the backend emits over
 * SSE, so the studio lights them up in real time as synthesis progresses.
 */
const stages = [
  {
    id: 'encoding',
    index: '01',
    name: 'Speaker encoder',
    net: 'GE2E &middot; 3-layer LSTM',
    takes: 'reference wav',
    gives: '256-d embedding',
    blurb:
      'Hears ~5s of a voice and distils it to a single fixed-length vector that captures timbre, independent of what was said.',
  },
  {
    id: 'synthesizing',
    index: '02',
    name: 'Synthesizer',
    net: 'Tacotron &middot; attention',
    takes: 'text + embedding',
    gives: '80 &times; T mel',
    blurb:
      'Conditions on that vector and decodes the text into a mel spectrogram, one frame at a time, attending to characters as it goes.',
  },
  {
    id: 'vocoding',
    index: '03',
    name: 'Vocoder',
    net: 'WaveRNN &middot; autoregressive',
    takes: '80 &times; T mel',
    gives: '16 kHz audio',
    blurb:
      'Turns the spectrogram back into pressure over time, sampling each of 16,000 values per second in sequence.',
  },
];
---
<section class="pipeline" id="how">
  <div class="shell">
    <header class="head">
      <p class="eyebrow">How it works</p>
      <h2>Three networks, in series.</h2>
      <p class="intro">
        The trick behind zero-shot cloning: the speaker&rsquo;s identity is separated from
        the words entirely. Stage one answers <em>who</em>, stage two answers
        <em>what</em>, stage three makes it audible. Watch them light up when you
        synthesise below.
      </p>
    </header>

    <ol class="stages" data-pipeline>
      {stages.map((stage) => (
        <li class="stage" data-stage={stage.id}>
          <div class="marker">
            <span class="idx">{stage.index}</span>
            <span class="beam" aria-hidden="true"></span>
          </div>
          <div class="body">
            <h3>{stage.name}</h3>
            <p class="net" set:html={stage.net} />
            <p class="blurb">{stage.blurb}</p>
            <p class="io">
              <span set:html={stage.takes} /><span class="arrow" aria-hidden="true">&rarr;</span><span class="out" set:html={stage.gives} />
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pipeline { padding-block: clamp(3rem, 6vw, 5rem); }
  .head { max-width: 60ch; margin-bottom: clamp(2rem, 4vw, 3rem); }
  h2 { font-size: var(--step-3); margin-block: 0.45em 0.6em; }
  .intro { color: var(--ink-soft); max-width: 58ch; }
  .intro em { color: var(--ink); font-style: italic; }

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 62rem) {
    .stages { grid-template-columns: repeat(3, 1fr); }
  }

  .stage {
    background: var(--paper);
    padding: 1.5rem 1.4rem 1.6rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    transition: background 0.4s var(--ease);
  }
  .stage[data-active] { background: var(--accent-wash); }
  .stage[data-done] .idx { color: var(--ok); border-color: var(--ok); }

  .marker { display: grid; gap: 0.5rem; justify-items: center; }
  .idx {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    width: 2rem; height: 2rem;
    display: grid;
    place-items: center;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .stage[data-active] .idx { color: var(--accent); border-color: var(--accent); }

  .beam {
    width: 1px;
    flex: 1;
    min-height: 1.5rem;
    background: var(--rule);
    align-self: stretch;
    position: relative;
    overflow: hidden;
  }
  .stage[data-active] .beam::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 40%;
    background: var(--accent);
    animation: travel 1.1s linear infinite;
  }
  @keyframes travel {
    from { top: -40%; } to { top: 100%; }
  }

  h3 { font-size: var(--step-1); }
  .net {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-top: 0.3rem;
  }
  .blurb { color: var(--ink-soft); font-size: var(--step--1); line-height: 1.6; margin-top: 0.75rem; }
  .io {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--rule);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .io .arrow { color: var(--rule-strong); }
  .io .out { color: var(--ink); }
</style>
