---
/**
 * The Preeti key map: a drawn keyboard showing what each key types in the
 * "Preeti layout" typing mode. Large glyph: the key on its own. Small glyph: with Shift.
 *
 * Every Devanagari glyph is read at build time from nepalify's `traditional` layout,
 * the same map scripts/nepali-input.ts types with. This replaced a PNG of the classic
 * Preeti font chart, which disagreed with that map on the number row and on most
 * Shift keys (it said 1 types ज्ञ; the textarea types १), and which could not follow
 * the light/dark theme. Generated, the chart cannot drift from the input.
 *
 * Static markup only: no `data-` hooks, no client script. NepaliInput owns the
 * figure around it and the toggle that shows it.
 */
import nepalify from 'nepalify';

/** What a key types in Preeti mode: the lookup the textarea's interceptor makes. */
const preeti = (key: string) => nepalify.format(key, { layout: 'traditional' });

/** = and + type joiners, which have no glyph of their own; they get a label. */
const INVISIBLE: Record<string, { label: string; name: string }> = {
  '‍': { label: 'ZWJ', name: 'zero-width joiner' },
  '‌': { label: 'ZWNJ', name: 'zero-width non-joiner' },
};

/** Vowel signs, virama, anusvara and friends attach to a letter. */
const ATTACHES = /^\p{M}/u;

interface Output {
  /** What the key cap shows. */
  glyph: string;
  /** What a screen reader hears. */
  spoken: string;
  /** False for the joiner labels, which are English. */
  nepali: boolean;
}

function output(text: string): Output {
  const invisible = INVISIBLE[text];
  if (invisible) return { glyph: invisible.label, spoken: invisible.name, nepali: false };
  // A mark on its own is drawn on a dotted circle, the standard placeholder base.
  return { glyph: ATTACHES.test(text) ? `◌${text}` : text, spoken: text, nepali: true };
}

interface Modifier {
  /** Width in key units; a character key is 1. */
  w: number;
  label?: string;
  icon?: 'backspace' | 'win';
  /** Label sits bottom-right, as on the right-hand side of a real keyboard. */
  end?: boolean;
  /** The upper arm of the L-shaped enter key; the lower arm is `enter`. */
  enterTop?: boolean;
  enter?: boolean;
}

/**
 * A character key is written as its unshifted character, followed by its shifted
 * one unless it is a letter (whose shifted form is just the capital). The geometry,
 * including \ on the number row and the L-shaped enter, follows the chart this replaced.
 * Every row adds up to 15 units.
 */
const ROWS: Array<Array<string | Modifier>> = [
  ['`~', '1!', '2@', '3#', '4$', '5%', '6^', '7&', '8*', '9(', '0)', '-_', '=+', '\\|',
    { w: 1, icon: 'backspace' }],
  [{ w: 1.5, label: 'tab' }, ...'qwertyuiop', '[{', ']}', { w: 1.5, enterTop: true }],
  [{ w: 1.75, label: 'caps lock' }, ...'asdfghjkl', ';:', '\'"',
    { w: 2.25, label: 'enter', end: true, enter: true }],
  [{ w: 2.25, label: 'shift' }, ...'zxcvbnm', ',<', '.>', '/?',
    { w: 2.75, label: 'shift', end: true }],
  [{ w: 1.5, label: 'ctrl' }, { w: 1.25, icon: 'win' }, { w: 1.5, label: 'alt' }, { w: 6 },
    { w: 1.5, label: 'alt', end: true }, { w: 1.25, icon: 'win' }, { w: 2, label: 'ctrl', end: true }],
];

const keys = ROWS.flat().map((slot) => {
  if (typeof slot !== 'string') return { kind: 'modifier' as const, ...slot };
  const base = slot.charAt(0);
  const letter = slot.length === 1;
  const shift = letter ? base.toUpperCase() : slot.charAt(1);
  return {
    kind: 'character' as const,
    base,
    shift,
    letter,
    typed: output(preeti(base)),
    shifted: output(preeti(shift)),
  };
});
---
<div class="scroll" role="region" aria-label="Preeti key map" tabindex="0">
  <ul class="board" role="list">
    {keys.map((key) =>
      key.kind === 'character' ? (
        <li class:list={['key', { joiners: !key.typed.nepali || !key.shifted.nepali }]}>
          <span class="visually-hidden">
            Key {key.base}: <span lang={key.typed.nepali ? 'ne' : undefined}>{key.typed.spoken}</span>;
            with Shift: <span lang={key.shifted.nepali ? 'ne' : undefined}>{key.shifted.spoken}</span>.
          </span>
          <span class:list={['shifted', key.shifted.nepali ? 'deva' : 'invisible']}
                lang={key.shifted.nepali ? 'ne' : undefined} aria-hidden="true">{key.shifted.glyph}</span>
          <span class:list={['typed', key.typed.nepali ? 'deva' : 'invisible']}
                lang={key.typed.nepali ? 'ne' : undefined} aria-hidden="true">{key.typed.glyph}</span>
          <span class="cap" aria-hidden="true">
            {key.letter ? <span>{key.shift}</span> : <><span>{key.shift}</span><span>{key.base}</span></>}
          </span>
        </li>
      ) : (
        <li class:list={['key', 'modifier', { end: key.end, 'enter-top': key.enterTop, enter: key.enter }]}
            style={`--w: ${key.w * 4}`} aria-hidden="true">
          {key.label}
          {key.icon === 'backspace' && (
            <svg viewBox="0 0 20 12" width="18" height="11">
              <path d="M19 6H2M6.5 1.5 2 6l4.5 4.5" fill="none" stroke="currentColor"
                    stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {key.icon === 'win' && (
            <svg viewBox="0 0 16 16" width="13" height="13">
              <path d="M1 1h6.5v6.5H1zM8.5 1H15v6.5H8.5zM1 8.5h6.5V15H1zM8.5 8.5H15V15H8.5z" fill="currentColor" />
            </svg>
          )}
        </li>
      ),
    )}
  </ul>
</div>

<style>
  /* Below ~42rem the keys would need text under the site's 0.7rem floor, so the
     board keeps that width and the region scrolls instead, like the /mos table.
     Both studios put this inside a <fieldset>, which never shrinks below its
     content's min-content width: without inline-size containment the board's
     min-width widened the whole step on phones and the page clipped it. */
  .scroll { overflow-x: auto; contain: inline-size; border-radius: var(--radius-lg); }

  .board {
    --gap: 0.3rem;
    /* Key glyphs scale with the board's own width, not the viewport. */
    container-type: inline-size;
    min-width: 42rem;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    display: grid;
    /* Quarter-key columns: every key width on the board is a multiple of 0.25. */
    grid-template-columns: repeat(60, minmax(0, 1fr));
    gap: var(--gap);
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
  }

  .key {
    position: relative;
    grid-column: span var(--w, 4);
    min-height: max(3.1rem, 6cqi);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    padding: 0.2rem 0.3rem 0.25rem 0.35rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
  }

  .shifted {
    grid-area: 1 / 1;
    font-size: clamp(0.72rem, 1.45cqi, 1rem);
    line-height: 1.3;
    color: var(--ink-soft);
  }
  .typed {
    grid-area: 2 / 1;
    align-self: end;
    justify-self: center;
    font-size: clamp(1.05rem, 2.6cqi, 1.75rem);
    line-height: 1.2;
    color: var(--ink);
  }
  /* The joiner labels: English, so mono and small, wherever they sit. */
  .shifted.invisible, .typed.invisible {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-soft);
  }

  /* The = key types two joiners. At the board's narrowest, "ZWNJ" beside its QWERTY
     legend is wider than a key at the site's 0.7rem floor, so this key stacks four
     lines instead: the Shift half on top, the unshifted half below. */
  .key.joiners {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr 1fr auto;
    padding: 0.1rem 0.25rem;
  }
  .joiners .cap { display: contents; }
  .joiners .cap > *, .joiners .invisible { line-height: 0.95; }
  .joiners .cap > :first-child { grid-area: 1 / 1; justify-self: end; }
  .joiners .shifted { grid-area: 2 / 1; }
  .joiners .typed { grid-area: 3 / 1; justify-self: start; }
  .joiners .cap > :last-child { grid-area: 4 / 1; justify-self: end; margin-top: 0; }

  /* The QWERTY legend: shifted character on top, unshifted below; letters show one. */
  .cap {
    grid-area: 1 / 2 / 3 / 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-left: 0.15rem;
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 1.25cqi, 0.86rem);
    line-height: 1.3;
    color: var(--ink-faint);
  }
  .cap > :last-child { margin-top: auto; }

  /* Keys that type nothing recede into the tray. */
  .modifier {
    display: flex;
    align-items: flex-end;
    padding: 0.3rem 0.45rem;
    background: var(--paper-sunk);
    border-color: var(--rule);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.2;
    color: var(--ink-faint);
  }
  .modifier.end { justify-content: flex-end; }
  .modifier:has(svg) { align-items: center; justify-content: center; }

  /* One L-shaped enter from two pieces: the upper arm reaches down through the row
     gap and paints over the lower arm's top border where they meet. */
  .enter-top {
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    margin-bottom: calc(-1 * var(--gap) - 1px);
    z-index: 1;
  }
  .enter { border-top-right-radius: 0; }
</style>
