---
interface Clip { src: string; type: string; sampleRate: number; duration: number }
interface Props {
  speaker: { id: number; label: string; clips: Record<string, Clip> };
}
const { speaker } = Astro.props;
const { clips } = speaker;

const clones = [
  { key: 'sameInput', title: 'Same text as the reference', hint: 'Direct A/B against the recording above.' },
  { key: 'short', title: 'Unseen text — short', hint: null },
  { key: 'medium', title: 'Unseen text — medium', hint: null },
  { key: 'long', title: 'Unseen text — long', hint: null },
] as const;

const mismatched = clips.original.sampleRate !== clips.short.sampleRate;
---
<article class="speaker" id={`speaker-${speaker.id}`}>
  <header>
    <h3>{speaker.label}</h3>
    {mismatched && (
      <p class="flag" title="Bandwidth alone can reveal which sample is synthetic.">
        original {clips.original.sampleRate / 1000} kHz vs clones 16 kHz
      </p>
    )}
  </header>

  <div class="row reference">
    <div class="meta">
      <p class="what">Original recording</p>
      <p class="num">{clips.original.duration}s &middot; {clips.original.sampleRate / 1000} kHz</p>
    </div>
    <audio controls preload="none" aria-label={`${speaker.label}, original human recording`}>
      <source src={clips.original.src} type={clips.original.type} />
      Your browser cannot play this audio.
    </audio>
  </div>

  {clones.map((clone) => {
    const clip = clips[clone.key];
    return clip ? (
      <div class="row">
        <div class="meta">
          <p class="what">{clone.title}</p>
          <p class="num">{clip.duration}s &middot; synthesised</p>
        </div>
        <audio controls preload="none" aria-label={`${speaker.label}, cloned: ${clone.title}`}>
          <source src={clip.src} type={clip.type} />
          Your browser cannot play this audio.
        </audio>
      </div>
    ) : null;
  })}
</article>

<style>
  .speaker {
    background: var(--paper);
    padding: 1.3rem 1.4rem 1.5rem;
    scroll-margin-top: 4.5rem;
  }
  header { display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1rem; }
  h3 { font-size: var(--step-2); }
  .flag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--warn);
    border: 1px solid color-mix(in srgb, var(--warn) 40%, transparent);
    border-radius: 2px;
    padding: 0.1rem 0.4rem;
  }

  .row { display: grid; gap: 0.35rem; padding-block: 0.6rem; }
  .row + .row { border-top: 1px dashed var(--rule); }
  .reference { padding-bottom: 0.9rem; border-bottom: 1px solid var(--rule-strong); }
  .reference .what { color: var(--accent); }

  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .what { font-size: var(--step--1); font-weight: 500; }
  .num { font-family: var(--font-mono); font-size: 0.66rem; color: var(--ink-faint); }

  audio { width: 100%; height: 36px; }
  audio:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (min-width: 46rem) {
    .row { grid-template-columns: 15rem 1fr; align-items: center; gap: 1.2rem; }
    .meta { flex-direction: column; gap: 0.1rem; align-items: flex-start; }
  }
</style>
