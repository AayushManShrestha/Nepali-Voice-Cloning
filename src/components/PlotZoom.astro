---
/**
 * The fullscreen plot dialog, shared by both results sections. This is the markup
 * half of scripts/plot-zoom.ts, which queries every `data-zoom*` hook here.
 */
---
<dialog class="zoom" data-zoom aria-label="Enlarged plot">
  <div class="zoom-bar">
    <p class="zoom-title" data-zoom-title></p>
    <button class="zoom-close" type="button" data-zoom-close aria-label="Close enlarged view">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <canvas data-zoom-canvas role="img" aria-label="Enlarged plot"></canvas>
  <p class="zoom-hint">
    <span class="for-keys">Press <kbd>Esc</kbd> or click outside to close</span>
    <span class="for-touch">Tap outside or &times; to close<span class="for-portrait">
      &middot; turn your phone sideways for a wider plot</span></span>
  </p>
</dialog>

<style>
  .zoom {
    width: min(96vw, 1600px);
    height: min(92vh, 1000px);
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }
  .zoom::backdrop { background: rgb(0 0 0 / 0.62); backdrop-filter: blur(3px); }
  .zoom[open] { display: grid; grid-template-rows: auto 1fr auto; }

  .zoom-bar {
    display: flex; align-items: center; gap: 1rem;
    padding: 0.8rem 1rem 0.8rem 1.2rem;
    border-bottom: 1px solid var(--rule);
  }
  .zoom-title {
    font-family: var(--font-mono); font-size: 0.76rem;
    letter-spacing: 0.04em; color: var(--ink-soft); margin: 0;
  }
  .zoom-close {
    margin-left: auto;
    display: grid; place-items: center;
    width: 30px; height: 30px; padding: 0;
    background: transparent; border: 1px solid var(--rule);
    border-radius: var(--radius); color: var(--ink-soft); cursor: pointer;
    transition: all 0.18s var(--ease);
  }
  .zoom-close:hover { border-color: var(--accent); color: var(--accent); }
  canvas {
    width: 100%; height: 100%;
    display: block;
    background: var(--viz-bg);
  }
  .zoom-hint {
    padding: 0.55rem 1.2rem 0.75rem;
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-faint); margin: 0;
  }
  /* There is no Esc key on a phone, and in portrait "full screen" makes the plot
     taller rather than wider -- which is the wrong way for a spectrogram. */
  .for-touch, .for-portrait { display: none; }
  @media (pointer: coarse) {
    .for-keys { display: none; }
    .for-touch { display: inline; }
  }
  @media (pointer: coarse) and (orientation: portrait) {
    .for-portrait { display: inline; }
  }
  kbd {
    font-family: var(--font-mono); font-size: 0.9em;
    border: 1px solid var(--rule-strong); border-bottom-width: 2px;
    border-radius: 3px; padding: 0.05em 0.3em;
  }
</style>
