---
/**
 * Output, grouped by pipeline stage, original against cloned wherever both exist.
 * Every canvas is drawn client-side from the raw arrays -- see scripts/viz.ts.
 */
---
<section class="results" id="results" data-results hidden>
  <div class="shell">
    <header class="head">
      <p class="eyebrow">Output</p>
      <h2>What came back.</h2>
      <p class="intro">
        Original on the left, cloned on the right, stage by stage. Every plot is drawn in
        your browser from raw arrays &mdash; the server used to render these as PNGs and
        ship 592&nbsp;KB per request, 86% of it pictures.
      </p>
    </header>

    <!-- ============================================ stage 01: speaker encoder -->
    <section class="stage-block">
      <header class="stage-head">
        <p class="stage-n">01</p>
        <div>
          <h3>Speaker encoder</h3>
          <p>The 256-d vector that encodes the voice, as a 16&times;16 grid. If cloning
             worked, the two should look alike &mdash; that similarity is the whole
             objective.</p>
        </div>
        <label class="switch">
          <input type="checkbox" data-embed-values />
          <span>Show values</span>
        </label>
      </header>
      <div class="pair">
        <figure>
          <figcaption>Original speaker embedding</figcaption>
          <canvas data-plot="embedding-original" height="300" role="img"
                  aria-label="Speaker embedding of the reference audio"></canvas>
        </figure>
        <figure>
          <figcaption class="cloned">Cloned speaker embedding</figcaption>
          <canvas data-plot="embedding-cloned" height="300" role="img"
                  aria-label="Speaker embedding re-extracted from the cloned audio"></canvas>
        </figure>
      </div>
      <p class="hoverhint">
        Hover either grid to read a single dimension &mdash; the same cell highlights in
        both, so you can compare them value by value.
        <span class="readout" data-embed-readout></span>
      </p>

      <div class="cosine" data-cosine hidden>
        <p class="cos-label">Cosine similarity</p>
        <div class="cos-formula">
          <span class="frac">
            <span class="num">a &middot; b</span>
            <span class="den">&Vert;a&Vert; &Vert;b&Vert;</span>
          </span>
          <span class="eq">=</span>
          <span class="frac">
            <span class="num" data-cos-dot></span>
            <span class="den"><span data-cos-na></span> &times; <span data-cos-nb></span></span>
          </span>
          <span class="eq">=</span>
          <b data-cos-value></b>
        </div>
        <p class="cos-note">
          The angle between the two 256-d vectors. Both norms come out at 1.000 because
          the GE2E encoder L2-normalises its output &mdash; every voice lands on the unit
          sphere &mdash; so the cosine here reduces to the plain dot product. 1.000 would
          mean the encoder places the cloned audio at exactly the same point as the
          original, i.e. it considers them the same speaker.
        </p>
      </div>
    </section>

    <!-- ============================================== stage 02: synthesizer -->
    <section class="stage-block">
      <header class="stage-head">
        <p class="stage-n">02</p>
        <div>
          <h3>Synthesizer</h3>
          <p>80 mel bands over time. The original is what the reference audio looks like;
             the cloned one is what Tacotron generated and handed to the vocoder.</p>
        </div>
      </header>
      <div class="pair">
        <figure>
          <figcaption>Mel spectrogram &mdash; original</figcaption>
          <canvas data-plot="mel-original" height="280" role="img"
                  aria-label="Mel spectrogram of the reference audio"></canvas>
        </figure>
        <figure>
          <figcaption class="cloned">Mel spectrogram &mdash; cloned</figcaption>
          <canvas data-plot="mel-cloned" height="280" role="img"
                  aria-label="Mel spectrogram of the cloned audio"></canvas>
        </figure>
      </div>

      <figure class="full">
        <figcaption>Attention alignment</figcaption>
        <p class="note">
          Which character the decoder attended to at each step. A clean diagonal means the
          model tracked the text; smearing or stalling means it lost its place. There is no
          &ldquo;original&rdquo; here &mdash; alignment only exists for generated speech.
        </p>
        <canvas data-plot="alignment" height="300" role="img"
                aria-label="Attention alignment matrix"></canvas>
      </figure>
    </section>

    <!-- ================================================= stage 03: vocoder -->
    <section class="stage-block">
      <header class="stage-head">
        <p class="stage-n">03</p>
        <div>
          <h3>Vocoder</h3>
          <p>The waveform, back in the time domain. Click either plot to seek.</p>
        </div>
      </header>
      <div class="pair">
        {['reference', 'cloned'].map((which) => (
          <figure>
            <figcaption class={which === 'cloned' ? 'cloned' : undefined}>
              {which === 'reference' ? 'Original audio' : 'Cloned audio'}
              <span class="who" data-player-name={which}></span>
            </figcaption>
            <canvas data-wave={which} height="220" role="img"
                    aria-label={`Waveform of the ${which} audio`}></canvas>
            <div class="transport">
              <button type="button" data-play={which} aria-label={`Play ${which} audio`}>
                <svg class="i-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.2v13.6L19 12z"/></svg>
                <svg class="i-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z"/></svg>
              </button>
              <p class="time"><span data-time={which}>0:00</span> / <span data-dur={which}>0:00</span></p>
              <a class="dl" data-download={which} download hidden>Download</a>
            </div>
            <audio data-audio={which} preload="metadata"></audio>
          </figure>
        ))}
      </div>
    </section>

    <div class="timings">
      <p class="eyebrow">Server timings</p>
      <ul data-timings></ul>
    </div>
  </div>
</section>

<style>
  .results { padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem); scroll-margin-top: 4rem; }
  .head { max-width: 60ch; margin-bottom: clamp(2rem, 4vw, 3rem); }
  h2 { font-size: var(--step-3); margin-block: 0.4em 0.5em; }
  .intro { color: var(--ink-soft); font-size: var(--step--1); }

  .stage-block { margin-bottom: clamp(2.2rem, 4vw, 3.4rem); }

  .stage-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1rem;
    align-items: start;
    padding-bottom: 0.9rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--rule-strong);
  }
  @media (min-width: 46rem) {
    .stage-head { grid-template-columns: auto 1fr auto; align-items: center; }
  }
  .stage-n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 50%;
    width: 2rem; height: 2rem;
    display: grid; place-items: center;
  }
  .stage-head h3 { font-size: var(--step-2); }
  .stage-head p { color: var(--ink-soft); font-size: var(--step--1); margin-top: 0.3rem; max-width: 62ch; }

  .switch {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.72rem;
    color: var(--ink-soft); cursor: pointer;
    border: 1px solid var(--rule); border-radius: 100px;
    padding: 0.3rem 0.75rem;
    white-space: nowrap;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }
  .switch:hover { border-color: var(--rule-strong); color: var(--ink); }
  .switch:has(input:checked) { border-color: var(--accent); color: var(--accent); }
  .switch:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .switch input { accent-color: var(--accent); margin: 0; }

  .pair { display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: var(--radius-lg); overflow: hidden; }
  @media (min-width: 52rem) { .pair { grid-template-columns: 1fr 1fr; } }

  figure { background: var(--paper); margin: 0; padding: 1.1rem 1.2rem 1.2rem; }
  figcaption {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    margin-bottom: 0.7rem;
    display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap;
  }
  figcaption.cloned { color: var(--accent); }
  .who { color: var(--ink-faint); font-size: 0.68rem; }

  canvas {
    width: 100%;
    display: block;
    background: var(--viz-bg);
    border-radius: var(--radius);
  }
  .pair [data-plot^='mel'] { height: 260px; }
  .pair [data-plot^='embedding'] { height: 300px; }
  .full [data-plot='alignment'] { height: 340px; }
  [data-wave] { height: 190px; cursor: pointer; }
  @media (max-width: 52rem) {
    .pair [data-plot^='mel'] { height: 220px; }
    .full [data-plot='alignment'] { height: 280px; }
  }

  .full {
    margin-top: 1px;
    border: 1px solid var(--rule);
    border-top: 0;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .pair + .full { border-radius: 0 0 var(--radius-lg) var(--radius-lg); }
  .full .note { color: var(--ink-soft); font-size: var(--step--1); margin-bottom: 0.9rem; max-width: 70ch; }

  .hoverhint {
    margin-top: 0.9rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
    display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap;
  }
  .readout {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    min-height: 1em;
  }

  .cosine {
    margin-top: 1.2rem;
    padding: 1rem 1.2rem;
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
  }
  .cos-label {
    font-family: var(--font-mono); font-size: 0.66rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint);
  }
  .cos-formula {
    display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap;
    margin-top: 0.7rem;
    font-family: var(--font-mono); font-size: 0.82rem;
  }
  .frac { display: inline-grid; justify-items: center; }
  .frac .num { padding: 0 0.5rem 0.15rem; }
  .frac .den { padding: 0.15rem 0.5rem 0; border-top: 1px solid var(--ink-faint); }
  .eq { color: var(--ink-faint); }
  .cos-formula b { font-size: 1.15rem; color: var(--accent); font-weight: 500; }
  .cos-note {
    margin-top: 0.8rem; font-size: var(--step--1);
    color: var(--ink-soft); max-width: 66ch;
  }

  .transport { display: flex; align-items: center; gap: 0.8rem; margin-top: 0.7rem; }
  .transport button {
    width: 30px; height: 30px; display: grid; place-items: center;
    background: var(--ink); color: var(--paper);
    border: 0; border-radius: 50%; cursor: pointer; flex: none;
    transition: background 0.18s var(--ease);
  }
  .transport button:hover { background: var(--accent); }
  .transport button svg { grid-area: 1 / 1; }
  .transport button .i-pause { display: none; }
  .transport button[data-playing] .i-play { display: none; }
  .transport button[data-playing] .i-pause { display: block; }
  .time { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-faint); margin: 0; }
  .dl {
    margin-left: auto; font-family: var(--font-mono); font-size: 0.7rem;
    letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-faint);
  }

  .timings { margin-top: 1.8rem; }
  /* Injected via innerHTML at runtime, so Astro's scoping attribute never reaches
     these nodes -- they must be addressed globally or they render unstyled. */
  .timings :global(ul) {
    list-style: none; margin: 0.7rem 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 1px;
    background: var(--rule); border: 1px solid var(--rule);
    border-radius: var(--radius); overflow: hidden;
  }
  .timings :global(li) {
    background: var(--paper); padding: 0.55rem 0.9rem; flex: 1 1 7rem;
    font-family: var(--font-mono); font-size: 0.72rem;
  }
  .timings :global(li b) {
    display: block; font-weight: 500; color: var(--ink-faint);
    font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase;
    margin-bottom: 0.15rem;
  }
  .timings :global(li span) { color: var(--ink); font-size: 0.9rem; }
  .timings :global(li[data-total] span) { color: var(--accent); }
</style>
