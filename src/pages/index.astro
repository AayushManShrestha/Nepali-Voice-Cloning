---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Pipeline from '../components/Pipeline.astro';
import Studio from '../components/Studio.astro';
import Results from '../components/Results.astro';
import Notes from '../components/Notes.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Base
  title="Nepali Voice Cloning"
  description="Clone a voice speaking Nepali from five seconds of reference audio. A three-stage SV2TTS pipeline — GE2E speaker encoder, Tacotron synthesizer, WaveRNN vocoder — running live on CPU."
>
  <SiteHeader status />
  <main id="main">
    <Hero />
    <hr class="rule shell-rule" />
    <Pipeline />
    <Studio />
    <Results />
    <Notes />
  </main>
  <SiteFooter />
</Base>

<script>
  import '../scripts/studio.ts';
</script>

<style is:global>
  body { display: flex; flex-direction: column; min-height: 100vh; }
  main { flex: 1; }
  .shell-rule {
    width: min(100% - (var(--gutter) * 2), 1180px);
    margin-inline: auto;
  }
</style>
